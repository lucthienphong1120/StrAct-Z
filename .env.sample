# Strava API Credentials
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_id
STRAVA_CLIENT_SECRET=your_strava_secret

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Mandatory: Encryption key for your tokens
APP_SECRET=your_long_random_encryption_key_here

# Optional: Initial admin account seeding (Fallback)
# If left empty, you will be prompted to create an admin account via the web UI on first launch.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_password
